{
  "name": "fins",
  "productName": "Fins",
  "version": "1.0.0",
  "private": true,
  "description": "A harbor aquarium shop that keeps going after you look away.",
  "author": "Chaos <chaos@users.noreply.github.com>",
  "license": "PolyForm-Small-Business-1.0.0",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "node tools/build.mjs",
    "check": "npm run check:syntax && npm run check:water && npm run check:folk && npm run check:build && npm run check:wiring && npm run check:lint && npm run check:boot",
    "check:syntax": "node tools/check-syntax.mjs",
    "check:water": "node tools/water-check.mjs",
    "check:folk": "node tools/folk-check.mjs",
    "check:polish": "node tools/polish-check.mjs",
    "check:build": "node tools/build.mjs --check",
    "check:wiring": "node tools/check-wiring.mjs",
    "check:lint": "eslint .",
    "check:boot": "node tools/boot-check.mjs",
    "check:install": "npm install --no-save --no-audit --no-fund eslint@10.1.0 playwright@1.56.1 esbuild@0.28.2 && playwright install chromium",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.chaos.fins",
    "productName": "Fins",
    "copyright": "Copyright © 2026 Chaos",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "desktop/**/*",
      "game/**/*",
      "package.json"
    ],
    "extraMetadata": { "main": "desktop/main.cjs" },
    "mac": {
      "category": "public.app-category.games",
      "target": ["dmg", "zip"],
      "identity": null
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game",
      "executableName": "Fins"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^37.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.2"
  }
}
